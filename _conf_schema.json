{
  "enabled": {
    "description": "启用原生 LLM 聊天准入",
    "type": "bool",
    "default": true
  },
  "owner_qq_ids": {
    "description": "Owner QQ 号列表",
    "type": "list",
    "default": []
  },
  "inherit_astrbot_admins": {
    "description": "将 AstrBot 全局管理员中的 QQ 号作为 Owner",
    "hint": "仅当全局管理员列表中的数字 ID 都是你信任的 QQ 号时开启。Owner 聊天仍需授权或开启 Bot 的聊天豁免。",
    "type": "bool",
    "default": false
  },
  "reviewer_qq_ids": {
    "description": "初始审核员 QQ 号列表",
    "type": "list",
    "default": []
  },
  "private_chat": {
    "description": "私聊管理指令",
    "type": "object",
    "items": {
      "admin_commands_enabled": {
        "description": "允许 Owner 和 Reviewer 在私聊执行 /ga",
        "type": "bool",
        "default": true
      }
    }
  },
  "application": {
    "description": "申请限频",
    "type": "object",
    "items": {
      "rate_limit_per_hour": {
        "description": "每 Bot、用户、域每小时可新建的待审申请数。0 表示不限频",
        "type": "int",
        "default": 5
      },
      "query_limit": {
        "description": "每 Bot、用户、域在窗口内允许发起等级查询的申请次数",
        "type": "int",
        "default": 3
      },
      "query_window_seconds": {
        "description": "申请命令限频窗口（秒）",
        "type": "int",
        "default": 60
      }
    }
  },
  "notifications": {
    "description": "私聊通知队列",
    "type": "object",
    "items": {
      "retry_enabled": {
        "description": "启动私聊通知队列发送器",
        "type": "bool",
        "default": true
      },
      "max_retries": {
        "description": "通知最大尝试次数",
        "type": "int",
        "default": 5
      },
      "retry_interval_seconds": {
        "description": "通知重试基准间隔（秒）",
        "type": "int",
        "default": 60
      }
    }
  },
  "security": {
    "description": "审计保留",
    "type": "object",
    "items": {
      "keep_audit_days": {
        "description": "启动时保留最近多少天的审计。0 表示保留全部",
        "type": "int",
        "default": 90
      }
    }
  }
}
